{
  "name": "tune-vscode",
  "displayName": "Tune CLI",
  "version": "1.6.2",
  "publisher": "RithvikShetty",
  "description": "Professional Spotify playback control interface - powered by Tune CLI.",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "spotify",
    "music",
    "playback",
    "cli",
    "developer tools",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tune-sidebar",
          "title": "Tune",
          "icon": "$(music)"
        }
      ]
    },
    "views": {
      "tune-sidebar": [
        {
          "type": "webview",
          "id": "tune.playerView",
          "name": "Player",
          "icon": "$(music)"
        }
      ]
    },
    "commands": [
      {
        "command": "tune.play",
        "title": "Tune: Play/Pause",
        "icon": "$(play-circle)"
      },
      {
        "command": "tune.next",
        "title": "Tune: Next Track",
        "icon": "$(chevron-right)"
      },
      {
        "command": "tune.prev",
        "title": "Tune: Previous Track",
        "icon": "$(chevron-left)"
      },
      {
        "command": "tune.status",
        "title": "Tune: Show Status"
      },
      {
        "command": "tune.search",
        "title": "Tune: Search & Play"
      },
      {
        "command": "tune.install",
        "title": "Tune: Install CLI"
      },
      {
        "command": "tune.login",
        "title": "Tune: Login to Spotify"
      },
      {
        "command": "tune.setup",
        "title": "Tune: Run Setup Wizard"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tune.play"
        },
        {
          "command": "tune.next"
        },
        {
          "command": "tune.prev"
        },
        {
          "command": "tune.status"
        },
        {
          "command": "tune.search"
        },
        {
          "command": "tune.install"
        },
        {
          "command": "tune.login"
        },
        {
          "command": "tune.setup"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.x",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rithvikshettyy/DevTune.git",
    "directory": "tune-vscode"
  },
  "license": "MIT",
  "icon": "devtune_icon.png"
}
